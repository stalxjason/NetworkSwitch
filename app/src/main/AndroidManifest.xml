<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络状态权限（读取网络能力与链路信息；App 自身不发起任何网络请求） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 电话状态权限（读取运营商、SIM 卡信息；READ_BASIC_PHONE_STATE 为 normal 权限） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />

    <!-- Shizuku 权限 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- targetSdk 30+ 包可见性：允许检测并拉起 Shizuku 应用 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- WiFi 密码查看不依赖电话硬件，required=false 才能装到平板/模拟器/ChromeOS -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- 不参与任何备份：本应用只存偏好设置，密码类工具不应把私有数据带进云端/换机迁移 -->
    <application
        android:name=".NetworkSwitchApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetworkSwitch">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 已保存 WiFi 密码查看 -->
        <activity
            android:name=".wifi.WifiListActivity"
            android:exported="false"
            android:label="@string/wifi_password_page" />

        <!--
          桌面 Widget。
          exported=false：系统以显式广播投递 APPWIDGET_UPDATE、PendingIntent 点击也不受影响，
          但第三方应用再也无法向这里发广播——令牌校验只剩第二道保险。
        -->
        <receiver
            android:name=".NetworkWidgetProvider"
            android:label="@string/widget_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/network_widget_info" />
        </receiver>

        <!-- 桌面 Widget（竖向：文字在上、按钮在下） -->
        <receiver
            android:name=".NetworkVerticalWidgetProvider"
            android:label="@string/widget_name_vertical"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/network_widget_vertical_info" />
        </receiver>

        <!-- 桌面 Widget（可自由调节尺寸，文字随尺寸缩放） -->
        <receiver
            android:name=".ResizableNetworkWidgetProvider"
            android:label="@string/widget_name_resizable"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/network_widget_resizable_info" />
        </receiver>

        <!-- Shizuku Provider（exported 是 Shizuku 探测/授权所必需，靠权限收敛访问面） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
