<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 宸︿晶淇℃伅鍖猴紙鏂囧瓧澶у皬鐢?Provider 鎸夌粍浠跺昂瀵稿姩鎬佽缃紱鎷夊鍚庡眳涓級 -->
        <LinearLayout
            android:id="@+id/widget_info_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_mode"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_carrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_preview_carrier"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_signal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_preview_signal"
                android:textColor="#66FFFFFF"
                android:textSize="9sp" />

            <!-- 浠ヤ笅浠呯珫鍚戞媺浼革紙楂?鈮? 鏍硷級鏃舵樉绀猴紝鐢?Provider 鎺у埗鍙鎬т笌鍐呭 -->
            <TextView
                android:id="@+id/tv_widget_sims"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/widget_preview_sims"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_widget_ips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/widget_preview_ips"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 鍙充晶鍒囨崲鎸夐挳锛堝昂瀵哥敱 Provider 鎸夌粍浠跺昂瀵稿姩鎬佽缃級 -->
        <FrameLayout
            android:id="@+id/btn_widget_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_btn_desc" />

            <TextView
                android:id="@+id/tv_widget_btn_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/widget_btn_label"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
