<?xml version="1.0" encoding="utf-8"?>
<!-- 主卡渐变底：颜色来自主题（?attr/heroStart → heroEnd），随主题色一起变 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="?attr/heroEnd"
        android:startColor="?attr/heroStart"
        android:type="linear" />
    <corners android:radius="@dimen/hero_corner" />
</shape>
