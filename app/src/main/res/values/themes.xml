<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 浅色：状态栏前景由 enableEdgeToEdge() 按主题自动适配，不再这里写死 -->
    <style name="Theme.NetworkSwitch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- 备选主题色 overlay：setTheme 后 applyStyle 覆盖 colorPrimary -->
    <style name="AccentOverlay.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue</item>
    </style>

    <style name="AccentOverlay.Green" parent="">
        <item name="colorPrimary">@color/accent_green</item>
    </style>

    <style name="AccentOverlay.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple</item>
    </style>

    <style name="AccentOverlay.Orange" parent="">
        <item name="colorPrimary">@color/accent_orange</item>
    </style>

</resources>
