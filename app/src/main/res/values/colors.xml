<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      外观主题：深浅模式 + 主题色。
      主题色不再是「只换 colorPrimary」，而是一整套色板（见下方 accent_* 分组），
      由 themes.xml 的 AccentOverlay.* 交给 colorPrimary / heroStart / heroEnd / tileBg。
      深色值见 values-night/colors.xml。
    -->

    <!-- 浅色主题（默认） -->

    <color name="background">#F4F6F8</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="text_primary">#1B1F24</color>
    <color name="text_secondary">#5F6B76</color>
    <color name="text_hint">#9AA4AE</color>

    <!-- 默认主色（未选 overlay 时的兜底，等于蓝色） -->
    <color name="primary">#1E88E5</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- ── 主题色色板：每个主题色一套（主色 / 主卡渐变起止 / 行首瓦片底） ── -->

    <color name="accent_blue">#1E88E5</color>
    <color name="accent_blue_hero_start">#2E93E8</color>
    <color name="accent_blue_hero_end">#1258A8</color>
    <color name="accent_blue_tile">#EDF3FA</color>

    <color name="accent_green">#2E9E5B</color>
    <color name="accent_green_hero_start">#34A96A</color>
    <color name="accent_green_hero_end">#146B3A</color>
    <color name="accent_green_tile">#E9F6EE</color>

    <color name="accent_purple">#8E5AE8</color>
    <color name="accent_purple_hero_start">#9B6BF0</color>
    <color name="accent_purple_hero_end">#5B2FA8</color>
    <color name="accent_purple_tile">#F2ECFD</color>

    <color name="accent_orange">#F28B30</color>
    <color name="accent_orange_hero_start">#F49B47</color>
    <color name="accent_orange_hero_end">#B4560F</color>
    <color name="accent_orange_tile">#FDF0E4</color>

    <color name="accent_cyan">#0E9AA7</color>
    <color name="accent_cyan_hero_start">#17A9B5</color>
    <color name="accent_cyan_hero_end">#0A6670</color>
    <color name="accent_cyan_tile">#E6F6F7</color>

    <color name="accent_rose">#E0457B</color>
    <color name="accent_rose_hero_start">#EA5A8C</color>
    <color name="accent_rose_hero_end">#A02454</color>
    <color name="accent_rose_tile">#FDECF2</color>

    <!-- 语义色：徽章底、分隔线（双主题各自定义） -->
    <color name="chip_bg">#14000000</color>
    <color name="divider">#EDF0F3</color>

    <!-- 主题色卡片上的前景层级（始终压在渐变上，两种主题都用白色透明度） -->
    <color name="on_primary_70">#B3FFFFFF</color>
    <color name="on_primary_80">#CCFFFFFF</color>
    <color name="on_primary_13">#22FFFFFF</color>

    <!-- 状态胶囊：正常 / 需要授权 -->
    <color name="pill_ok_bg">#E8F5EE</color>
    <color name="pill_ok_fg">#1F7A43</color>
    <color name="pill_warn_bg">#FFF3E2</color>
    <color name="pill_warn_fg">#A96000</color>

    <!-- 主卡上的半透明胶囊与状态点 -->
    <color name="hero_pill_bg">#2EFFFFFF</color>
    <color name="hero_pill_stroke">#47FFFFFF</color>
    <color name="status_dot">#9BF0BE</color>
    <!-- 需要授权时的状态点：主卡是深色渐变，琥珀色比暗黄更亮、更醒目 -->
    <color name="status_dot_warn">#FFC46B</color>

    <!-- Adaptive icon 背景色（从启动图采样，与图标主色一致） -->
    <color name="ic_launcher_background">#FF0064D6</color>

</resources>
